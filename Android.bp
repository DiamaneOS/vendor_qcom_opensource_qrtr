cc_library {
    name: "libqrtr",
    // Installed as libqrtr_linux_msm.so, so it can sit next to a vendor
    // libqrtr.so that other libraries on the device link.
    stem: "libqrtr_linux_msm",
    vendor: true,
    srcs: [
        "lib/logging.c",
        "lib/qmi.c",
        "lib/qrtr.c",
    ],
    cflags: [
        "-Wno-error",
        "-fPIC",
    ],
    export_include_dirs: [
        "include",
        "lib",
    ],
    local_include_dirs: [
        "include",
        "src",
    ],
}

cc_binary {
    name: "qrtr-cfg",
    vendor: true,
    srcs: [
        "lib/logging.c",
        "src/addr.c",
        "src/cfg.c",
    ],
    cflags: ["-Wno-error"],
    local_include_dirs: [
        "include",
        "lib",
    ],
}

cc_binary {
    name: "qrtr-lookup",
    vendor: true,
    srcs: [
        "lib/logging.c",
        "src/lookup.c",
    ],
    cflags: ["-Wno-error"],
    local_include_dirs: [
        "include",
        "lib",
    ],
}
